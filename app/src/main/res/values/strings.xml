    <!-- Steps of the setting dialog, one bullet per line. -->
    <string name="instruction_advanced_protection">Open Security &amp; privacy › Other settings\nOpen Advanced Protection\nTurn on “Device protection”</string>
    <string name="instruction_airplane">Turn on airplane mode</string>
    <string name="instruction_biometrics">Remove saved fingerprints\nRemove face unlock</string>
    <string name="instruction_ble_scan">Turn off “Bluetooth scanning”</string>
    <string name="instruction_ble_scan_entry">Open Location › Scanning\nTurn off “Bluetooth scanning”</string>
    <string name="instruction_ble_scan_menu">Open Location › ⋮ › Scanning\nTurn off “Bluetooth scanning”</string>
    <string name="instruction_ble_scan_vendor">Open the location settings\nTurn off Bluetooth scanning</string>
    <string name="instruction_bluetooth">Turn off Bluetooth</string>
    <string name="instruction_developer_options">Turn off “Use developer options” (switch at the top)</string>
    <string name="instruction_device_name">Replace it with a neutral name, without first or last name</string>
