    <string name="why_airplane">Your phone can be located and identified.</string>
    <string name="why_location">Your position can be recorded and shared.</string>
    <string name="why_wifi">Your phone can be detected and tracked.</string>
    <string name="why_bluetooth">Your phone can be detected and tracked.</string>
