    <string name="why_ble_scan">Locates you even when Bluetooth is off.</string>
    <string name="why_hotspot">Broadcasts a visible, identifiable network around you.</string>
    <string name="why_mobile_data">Apps can send information about you.</string>
    <string name="why_nfc">Can exchange data with a nearby reader.</string>
    <string name="why_uwb">Can locate you precisely at short range.</string>
    <string name="why_screen_lock">Anyone can open your phone.</string>
